            "devices": [
              {
                "id": "a",
                "battery": 18
              }
            ],
            "expect": []
          },
          {
            "devices": [
              {
                "id": "a",
                "battery": 18
              },
              {
                "id": "b",
                "battery": 18
              }
            ],
