  "alerts": {
    "scenarios": [
      {
        "name": "single low notification, then quiet",
        "enabled": true,
        "steps": [
          {
            "devices": [
              {
                "id": "a",
                "battery": 18
              }
            ],
            "expect": [
              "low"
            ]
          },
          {
            "devices": [
              {
                "id": "a",
                "battery": 17
              }
            ],
            "expect": []
          }
        ]
      },
      {
        "name": "low then critical, no repeat",
        "enabled": true,
        "steps": [
          {
            "devices": [
              {
                "id": "a",
                "battery": 19
              }
            ],
            "expect": [
              "low"
            ]
          },
          {
            "devices": [
              {
                "id": "a",
                "battery": 9
              }
            ],
            "expect": [
              "critical"
            ]
          },
          {
            "devices": [
              {
                "id": "a",
                "battery": 8
              }
            ],
            "expect": []
          }
        ]
      },
      {
        "name": "charging re-arms the device",
        "enabled": true,
        "steps": [
          {
            "devices": [
              {
                "id": "a",
                "battery": 15
              }
            ],
            "expect": [
              "low"
            ]
          },
          {
            "devices": [
              {
                "id": "a",
                "battery": 15,
                "charging": true
              }
            ],
            "expect": []
          },
          {
            "devices": [
              {
                "id": "a",
                "battery": 15
              }
            ],
            "expect": [
              "low"
            ]
          }
        ]
