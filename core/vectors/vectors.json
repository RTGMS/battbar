{
  "$comment": "Single source of truth for protocol behaviour. Consumed by core/battbar-core/tests/vectors.rs, core/scripts/crosscheck.mjs (Electron/JS) and core/scripts/crosscheck-swift.sh (shipped macOS app). 'targets' lists the implementations that are required to agree; a case missing 'swift' or 'js' documents a known, intentional difference.",
  "atk": {
    "request_hex": "0804000000000000000000000000000049",
    "decode": [
      {
        "name": "full 17-byte report",
        "report_id": 8,
        "hex": "0804000000026401107200000000000060",
        "expect": {
          "kind": "reading",
          "battery": 100,
          "charging": true
        }
      },
      {
        "name": "payload without the report-id prefix",
        "report_id": 8,
        "hex": "04000000026401",
        "expect": {
          "kind": "reading",
          "battery": 100,
          "charging": true
        },
        "targets": [
          "rust",
          "swift"
        ]
      },
      {
        "name": "charging flag is explicit",
        "report_id": 8,
        "hex": "08040000000241000000000000000000",
        "expect": {
          "kind": "reading",
          "battery": 65,
          "charging": false
        }
      },
      {
        "name": "battery above 100 is clamped",
        "report_id": 8,
        "hex": "080400000002ff000000000000000000",
        "expect": {
          "kind": "reading",
          "battery": 100,
          "charging": false
        }
      },
      {
        "name": "non-zero status is reported, not swallowed",
        "report_id": 8,
        "hex": "04010000026401",
        "expect": {
          "kind": "status",
          "status": 1
        },
        "targets": [
          "rust",
          "swift"
        ]
      },
      {
        "name": "another report id is ignored",
        "report_id": 9,
        "hex": "09040000003200000000000000000000",
        "expect": {
          "kind": "not_for_us"
        }
      },
      {
        "name": "short report is ignored",
        "report_id": 8,
        "hex": "080400000064",
        "expect": {
          "kind": "not_for_us"
        }
      }
    ],
