{
  "name": "battbar",
  "version": "2.3.0",
  "description": "BattBar（电量栏）——跨平台无线外设电量托盘应用，已适配 ATK / VXE 等 Compx 方案鼠标。",
  "main": "electron/main.js",
  "private": true,
  "author": {
    "name": "Chen Wenjia"
  },
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"tests/*.test.js\"",
    "probe:hid": "node tools/hid-probe.js list",
    "probe:atk": "node tools/hid-probe.js atk",
    "probe:razer": "node tools/hid-probe.js razer",
    "icons": "python3 scripts/make-icons.py",
    "pack:dir": "electron-builder --dir",
    "pack:mac": "electron-builder --mac dmg zip --arm64 --publish never",
    "pack:win": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "node-hid": "3.4.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.battbar.app",
    "productName": "BattBar",
    "copyright": "Copyright © 2026 Chen Wenjia",
    "artifactName": "BattBar-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-hid/**/*",
      "node_modules/pkg-prebuilds/**/*",
      "electron/providers/windows-bt.ps1"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "LSUIElement": true,
        "NSBluetoothAlwaysUsageDescription": "用于读取已连接蓝牙鼠标的电量。"
      }
    },
    "dmg": {
      "title": "BattBar ${version}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "电量栏",
      "deleteAppDataOnUninstall": false
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ]
  }
}
